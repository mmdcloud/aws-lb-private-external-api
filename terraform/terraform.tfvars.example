# ==============================================================================
# AWS Configuration
# ==============================================================================
aws_region      = "us-east-1"
azs             = ["us-east-1a", "us-east-1b", "us-east-1c"]
aws_vpc_cidr    = "10.0.0.0/16"
public_subnets  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnets = ["10.0.4.0/24", "10.0.5.0/24", "10.0.6.0/24"]
aws_bgp_asn     = 64512

# ==============================================================================
# HTTPS & SSL/TLS Configuration
# ==============================================================================
# Optional: supply an existing ACM Certificate ARN. If omitted/null, a self-signed
# certificate will be automatically generated and imported into ACM:
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

domain_name          = "api.example.internal"
ssl_policy           = "ELBSecurityPolicy-TLS13-1-2-2021-06"
enable_http_redirect = true

# ==============================================================================
# Google Cloud Platform (GCP) Configuration (Private External API)
# ==============================================================================
gcp_project_id      = "my-gcp-production-project-id"
gcp_region          = "us-central1"
gcp_zones           = ["us-central1-a", "us-central1-b", "us-central1-c"]
gcp_vpc_cidr        = "10.20.0.0/16"
gcp_private_subnets = ["10.20.1.0/24", "10.20.2.0/24", "10.20.3.0/24"]
gcp_bgp_asn         = 64514
gcp_machine_type    = "e2-small"

# ==============================================================================
# Environment & Tagging
# ==============================================================================
environment = "prod"

tags = {
  Environment = "production"
  ManagedBy   = "terraform"
  Project     = "aws-lb-private-external-api"
}

# ==============================================================================
# Optional: Custom External Private Endpoints
# ==============================================================================
# In addition to the auto-provisioned GCP backend instances, you can register
# custom private IP addresses (e.g. on-premises or existing hybrid endpoints):
# custom_external_endpoints = ["10.30.1.10", "10.30.2.10"]
